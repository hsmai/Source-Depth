#!/bin/bash
#PBS -N 1_4_isangmin_sd_anc
#PBS -q pleiades1
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /home/isangmin/sourcedepth/logs/pbs/
# anchor 벤치 v0 (docs/32) + 7B 절단 반사실
set -eo pipefail
ROOT=/home/isangmin/sourcedepth
cd $ROOT && source $ROOT/.venv/bin/activate
set -u
export HF_HOME=$ROOT/hf_cache HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONHASHSEED=42
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
date; nvidia-smi -L || true
python scripts/36_anchor_bench.py --limit 4 && echo "SMOKE OK"
python scripts/36_anchor_bench.py || echo "36-3B FAILED"
SD_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct SD_TAG=_7b python scripts/36_anchor_bench.py || echo "36-7B FAILED"
echo "===== 30 절단 반사실 (7B) ====="
SD_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct SD_TAG=_7b python scripts/30_truncated_counterfactual.py || echo "30-7B FAILED"
date
