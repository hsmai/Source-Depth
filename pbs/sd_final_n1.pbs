#!/bin/bash
#PBS -N 1_4_isangmin_sd_fin
#PBS -q pleiades1
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=05:00:00
#PBS -j oe
#PBS -o /home/isangmin/sourcedepth/logs/pbs/
# 미팅 전 마지막 3건 — 큐를 한 번만 기다리도록 하나로 묶음
#   31 비용 실측 (가장 짧고 FOCUS 차별성에 직결)  → 30 층 절단 반사실 → 29 읽기 깊이
set -eo pipefail
ROOT=/home/isangmin/sourcedepth
cd $ROOT
source $ROOT/.venv/bin/activate
set -u
export HF_HOME=$ROOT/hf_cache HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONHASHSEED=42
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
date; nvidia-smi || true

echo "===== [1/3] 31 비용 실측 (3B, ~5분) ====="
python scripts/31_cost_bench.py || echo "31 FAILED"

echo "===== [2/3] 30 층 절단 반사실 (3B, ~40분) ====="
python scripts/30_truncated_counterfactual.py --limit 8
echo "--- 스모크 통과 ---"
python scripts/30_truncated_counterfactual.py || echo "30 FAILED"

echo "===== [3/3] 29 읽기 깊이 (3B → 7B, ~90분) ====="
python scripts/29_read_depth.py || echo "29-3B FAILED"
SD_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct SD_TAG=_7b python scripts/29_read_depth.py || echo "29-7B FAILED"
date
