#!/bin/bash
#PBS -N 1_8_isangmin_sd_mainB
#PBS -q [QUEUE_NAME]
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /home1/isangmin/sourcedepth/logs/
# [선행 조건] sd_mainA와 동일. 양보 요청 시 이 job(2B)을 먼저 qdel — 이후 --shard 1 --resume으로 복구.

cd /home1/isangmin/sourcedepth

source /home1/isangmin/miniconda3/etc/profile.d/conda.sh
conda activate sourcedepth
set -euo pipefail

export HF_HOME=/home1/isangmin/.cache/huggingface
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONHASHSEED=42

date; nvidia-smi; echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"

# Phase 1: 본실험 shard 1
python scripts/03_run_main.py --pairs results/pairs.csv --shard 1 --num-shards 2 --resume --seed 42

# Phase 2: M 조건 attention 프로파일링 shard 1
python scripts/04_run_attention_profile.py --pairs results/pairs.csv --shard 1 --num-shards 2 --resume --seed 42

date
