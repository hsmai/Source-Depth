#!/bin/bash
#PBS -N 1_4_isangmin_sd_swap
#PBS -q pleiades1
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -o /home/isangmin/sourcedepth/logs/pbs/
# 뒤집은 순서 경로 분해 — 표현 오염 경로가 실제로 존재하는 배치에서 재측정
set -eo pipefail
ROOT=/home/isangmin/sourcedepth
cd $ROOT
source $ROOT/.venv/bin/activate
set -u
export HF_HOME=$ROOT/hf_cache
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONHASHSEED=42
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
date; nvidia-smi || true
echo "===== 스모크 6문항 ====="
python scripts/27_pathway_swapped.py --limit 6
echo "===== 스모크 통과 ====="
echo "===== 27 (3B) ====="
python scripts/27_pathway_swapped.py || echo "27-3B FAILED"
echo "===== 27 (7B) ====="
SD_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct SD_TAG=_7b python scripts/27_pathway_swapped.py || echo "27-7B FAILED"
date
