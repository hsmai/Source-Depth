#!/bin/bash
#PBS -N 1_4_isangmin_sd7b_sanity
#PBS -q pleiades4
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -o /home/isangmin/sourcedepth/logs/pbs/

set -eo pipefail
ROOT=/home/isangmin/sourcedepth
cd $ROOT
source $ROOT/.venv/bin/activate
set -u

export SD_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
export SD_TAG=_7b
export HF_HOME=$ROOT/hf_cache
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONHASHSEED=42

trap 'python scripts/05_analyze.py || true' EXIT

date; nvidia-smi || true; echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
python scripts/02_sanity_checks.py
date
