#!/bin/bash
#PBS -N 1_4_isangmin_sd_next
#PBS -q pleiades1
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /home/isangmin/sourcedepth/logs/pbs/
# A: RoPE 제거 컨트롤러 재측정 (3B)   B: 컨트롤러 오류 비용 (3B → 7B)
set -eo pipefail
ROOT=/home/isangmin/sourcedepth
cd $ROOT
source $ROOT/.venv/bin/activate
set -u
export HF_HOME=$ROOT/hf_cache
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONHASHSEED=42
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

date; nvidia-smi || true
echo "===== 스모크 A: no-RoPE hook 경로 (8문항) ====="
python scripts/19_controller_norope.py --limit 8
echo "===== 스모크 B: 오류비용 경로 (8문항) ====="
python scripts/21_controller_error_cost.py --limit 8
echo "===== 스모크 통과 ====="

echo "===== A: no-RoPE 컨트롤러 (3B, 600문항 × 원순서/뒤집기) ====="
python scripts/19_controller_norope.py || echo "A FAILED"
python scripts/20_norope_analyze.py || true

echo "===== B: 컨트롤러 오류 비용 (3B) ====="
python scripts/21_controller_error_cost.py || echo "B-3B FAILED"
echo "===== B: 컨트롤러 오류 비용 (7B) ====="
SD_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct SD_TAG=_7b python scripts/21_controller_error_cost.py || echo "B-7B FAILED"
date
