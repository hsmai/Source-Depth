#!/bin/bash
#PBS -N 1_4_isangmin_sd_bind3
#PBS -q pleiades1
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o /home/isangmin/sourcedepth/logs/pbs/
set -eo pipefail
ROOT=/home/isangmin/sourcedepth
cd $ROOT && source $ROOT/.venv/bin/activate
set -u
export HF_HOME=$ROOT/hf_cache HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONHASHSEED=42
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
date; nvidia-smi -L || true
python scripts/41_reference_binding.py --limit 2 && echo "SMOKE OK"
python scripts/41_reference_binding.py || echo "41 FAILED"
python scripts/42_refbind_analyze.py || echo "42 FAILED"
date
