#!/bin/bash
#PBS -N 1_8_isangmin_sd_gate
#PBS -q pleiades3
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /home/isangmin/sourcedepth/logs/pbs/
# Kill-gate 선행 실험 (미팅용, 탐색적): 07 relational 반대곡선 → 08 per-head feature 스윕
# → 09 실측 compaction TTFT. 3090 1장 (A6000 ext/7B 체인과 병렬 — 합산 token 2.5 상한 준수)

set -eo pipefail
ROOT=/home/isangmin/sourcedepth
cd $ROOT
source $ROOT/.venv/bin/activate
set -u

export HF_HOME=$ROOT/hf_cache
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONHASHSEED=42

date; nvidia-smi || true; echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
python scripts/07_relational.py
python scripts/08_headwise_profile.py
python scripts/09_compaction_bench.py
date
