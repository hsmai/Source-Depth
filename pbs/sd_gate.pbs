#!/bin/bash
#PBS -N 1_4_isangmin_sd_gate
#PBS -q pleiades4
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /home/isangmin/sourcedepth/logs/pbs/
# Kill-gate 선행 실험 (미팅용, 탐색적): 07 relational 반대곡선 → 08 per-head feature 스윕
# → 09 실측 compaction TTFT. A6000 1장 (사용자 지시: GPU 1장, 노드4 고정 — 순차 체인)
# 개별 스크립트 실패가 후속을 막지 않도록 || true (탐색적 실험 — 부분 결과도 유효)

set -eo pipefail
ROOT=/home/isangmin/sourcedepth
cd $ROOT
source $ROOT/.venv/bin/activate
set -u

export HF_HOME=$ROOT/hf_cache
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONHASHSEED=42

date; nvidia-smi || true; echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
echo "===== 07 relational ====="; python scripts/07_relational.py || echo "07 FAILED"
echo "===== 08 headwise ====="; python scripts/08_headwise_profile.py || echo "08 FAILED"
echo "===== 09 compaction ====="; python scripts/09_compaction_bench.py || echo "09 FAILED"
date
