#!/bin/bash
#PBS -N 1_4_isangmin_sd_gen
#PBS -q pleiades1
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /home/isangmin/sourcedepth/logs/pbs/
# 일반화·안전성·통합 (docs/35)
set -eo pipefail
ROOT=/home/isangmin/sourcedepth
cd $ROOT && source $ROOT/.venv/bin/activate
set -u
export HF_HOME=$ROOT/hf_cache HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONHASHSEED=42
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
date; nvidia-smi -L || true
python scripts/39_generalize.py --limit 3 && echo "SMOKE OK"
python scripts/39_generalize.py || echo "39-3B FAILED"
SD_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct SD_TAG=_7b python scripts/39_generalize.py || echo "39-7B FAILED"
date
