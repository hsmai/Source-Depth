#!/bin/bash
#PBS -N 1_4_isangmin_sd_hs
#PBS -q pleiades1
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=05:00:00
#PBS -j oe
#PBS -o /home/isangmin/sourcedepth/logs/pbs/
# A: HARD need-all (all-of-3)  B: 소프트 λ 스윕  — 3B 먼저, 7B 이어서
set -eo pipefail
ROOT=/home/isangmin/sourcedepth
cd $ROOT
source $ROOT/.venv/bin/activate
set -u
export HF_HOME=$ROOT/hf_cache
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONHASHSEED=42
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
date; nvidia-smi || true
echo "===== 스모크 6문항 ====="
python scripts/25_hard_needall_soft.py --limit 6
echo "===== 스모크 통과 ====="
echo "===== 25 (3B) ====="
python scripts/25_hard_needall_soft.py || echo "25-3B FAILED"
echo "===== 25 (7B) ====="
SD_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct SD_TAG=_7b python scripts/25_hard_needall_soft.py || echo "25-7B FAILED"
date
