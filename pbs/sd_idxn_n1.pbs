#!/bin/bash
#PBS -N 1_4_isangmin_sd_idxn
#PBS -q pleiades1
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=10:00:00
#PBS -j oe
#PBS -o /home/isangmin/sourcedepth/logs/pbs/
set -eo pipefail
ROOT=/home/isangmin/sourcedepth
cd $ROOT && source $ROOT/.venv/bin/activate
set -u
export HF_HOME=$ROOT/hf_cache HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONHASHSEED=42
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
date; nvidia-smi -L || true
SD_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct SD_TAG=_7b python scripts/43_index_vs_n.py --limit 2 && echo "SMOKE OK"
SD_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct SD_TAG=_7b python scripts/43_index_vs_n.py || echo "43-7B FAILED"
SD_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct SD_TAG=_7b python scripts/44_index_vs_n_analyze.py || echo "44-7B FAILED"
python scripts/43_index_vs_n.py || echo "43-3B FAILED"
python scripts/44_index_vs_n_analyze.py || echo "44-3B FAILED"
date
